# ==============================================================================
# Jev Sentinel Environment Variables Template
#
# Recommended paths:
#   System-wide:  /etc/default/jev-sentinel  (or /etc/jev-sentinel/env)
#   User session: ~/.config/jev-sentinel/env
# ==============================================================================

# Required: TypeSafe AI Jev System 1 API Key
TYPESAFE_API_KEY=apikey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Egress Proxy for restricted network environments (homelab egress gateway)
JEV_EGRESS_PROXY=http://10.0.0.2:8080

# Optional: Telegram Alerts
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFghijklmnop-qrstuvwxyz
TELEGRAM_CHAT_ID=123456789
TELEGRAM_PROXY=http://10.0.0.2:8080

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info
